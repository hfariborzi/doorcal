# Public URL of this deployment, no trailing slash. Used for the Google OAuth redirect and links in invites.
# If unset, the URL of the incoming request is used.
APP_URL=http://localhost:3000

# Shown in the UI. Optional.
NEXT_PUBLIC_APP_NAME=DoorCal

# Contact email shown in the footer, privacy policy and terms. Recommended for a public instance.
CONTACT_EMAIL=

# Postgres connection string.
# - Local: run `docker compose up -d` and use the line below.
# - Vercel + Neon: set for you when you add Neon from the Storage tab.
# Neon URLs (*.neon.tech) use Neon's HTTP driver; anything else uses node-postgres.
# Override with DATABASE_DRIVER=neon or DATABASE_DRIVER=pg if needed.
DATABASE_URL=postgres://doorcal:doorcal@localhost:5432/doorcal

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth client ID → Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Long random string. Signs sessions and encrypts stored Google tokens.
# Generate one with: openssl rand -base64 32
# Changing it signs everyone out and requires them to reconnect Google.
AUTH_SECRET=

# Optional sign-up restrictions (comma-separated). Leave both empty to let anyone with a Google account sign up.
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# Vercel preview builds skip database migrations so they can't change a shared production database.
# Set to true (Preview environment only) if each preview deployment gets its own database branch.
MIGRATE_PREVIEWS=
