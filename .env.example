# Public URL of this deployment, no trailing slash. Used for the OAuth redirects and links in invites.
# If unset, the URL of the incoming request is used.
APP_URL=http://localhost:3000

# Shown in the UI. Optional.
NEXT_PUBLIC_APP_NAME=DoorCal

# Contact email shown in the footer, privacy policy and terms. Recommended for a public instance.
CONTACT_EMAIL=

# Postgres connection string.
# - Local: run `docker compose up -d` and use the line below.
# - Vercel + Neon: set for you when you add Neon from the Storage tab.
# Neon URLs (*.neon.tech) use Neon's HTTP driver; anything else uses node-postgres.
# Override with DATABASE_DRIVER=neon or DATABASE_DRIVER=pg if needed.
DATABASE_URL=postgres://doorcal:doorcal@localhost:5432/doorcal

# Google OAuth client (Google Cloud Console → APIs & Services → Credentials → OAuth client ID → Web application)
# Redirect URI: <APP_URL>/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth client (Microsoft Entra admin center → App registrations). Optional: leave empty to offer
# Google only. Redirect URI: <APP_URL>/api/auth/microsoft/callback
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Long random string. Signs sessions and encrypts stored calendar tokens.
# Generate one with: openssl rand -base64 32
# Changing it signs everyone out and requires them to reconnect their calendars.
AUTH_SECRET=

# Optional sign-up restrictions (comma-separated). Leave both empty to let anyone sign up.
# Applies to every account that is signed in with or connected.
ALLOWED_EMAILS=
ALLOWED_DOMAINS=

# Vercel preview deployments (including a staging branch) use this database instead of DATABASE_URL when it
# is set, and migrate it on build. Easiest: add a second Neon database to the project for the Preview
# environment only with the variable prefix PREVIEW_. Without it, previews share DATABASE_URL and skip
# migrations unless MIGRATE_PREVIEWS=true.
PREVIEW_DATABASE_URL=
MIGRATE_PREVIEWS=

# Optional AI categorisation (opt-in per user). Any OpenAI-compatible chat-completions endpoint works:
# OpenAI, Groq, Mistral, OpenRouter, Gemini's compatibility endpoint, or self-hosted vLLM/Ollama. The task
# is tiny (sorting titles into a list), so use the cheapest model your provider offers. Leave empty to hide
# the feature. Examples:
#   OpenAI: AI_BASE_URL=https://api.openai.com/v1      AI_MODEL=gpt-5-nano
#   Groq:   AI_BASE_URL=https://api.groq.com/openai/v1 AI_MODEL=llama-3.1-8b-instant
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# Shown to users on the consent screen and in the privacy policy, e.g. "OpenAI".
AI_PROVIDER_NAME=
# Caps on events sent to the AI per day (per user, and for the whole instance).
AI_MAX_EVENTS_PER_USER_PER_DAY=300
AI_MAX_EVENTS_PER_DAY=20000

# Dori, the optional assistant (opt-in per user). Uses the AI provider above; DORI_MODEL overrides AI_MODEL for
# her only. Pick a model with reliable tool calling.
DORI_MODEL=
DORI_MAX_TURNS_PER_USER_PER_DAY=100
DORI_MAX_TURNS_PER_DAY=5000
# Dori's voice (talking to her, and reading answers aloud) uses ElevenLabs through OpenRouter, on
# zero-data-retention endpoints only. It turns on by itself when AI_BASE_URL is OpenRouter; otherwise the
# browser's own speech recognition and voices are used.
DORI_STT_MODEL=elevenlabs/scribe-v2
DORI_TTS_MODEL=elevenlabs/eleven-v4-turbo
DORI_VOICE=sarah
DORI_MAX_VOICE_SECONDS_PER_USER_PER_DAY=1800
DORI_MAX_SPEECH_CHARS_PER_USER_PER_DAY=20000

# Daily job (vercel.json) that renews calendar push notifications. Vercel sends this as a bearer token.
# Generate one with: openssl rand -base64 32
CRON_SECRET=
