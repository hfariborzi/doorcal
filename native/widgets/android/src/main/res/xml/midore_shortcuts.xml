<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the Midore icon: add a task without opening the app, or open today. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="add"
        android:enabled="true"
        android:icon="@drawable/midore_shortcut_add"
        android:shortcutShortLabel="@string/midore_shortcut_add"
        android:shortcutLongLabel="@string/midore_shortcut_add_long">
        <intent
            android:action="app.midore.QUICK_ADD"
            android:targetPackage="app.midore"
            android:targetClass="app.midore.widgets.QuickAddActivity" />
    </shortcut>
    <shortcut
        android:shortcutId="today"
        android:enabled="true"
        android:icon="@drawable/midore_shortcut_today"
        android:shortcutShortLabel="@string/midore_shortcut_today">
        <intent
            android:action="android.intent.action.VIEW"
            android:data="midore://open"
            android:targetPackage="app.midore"
            android:targetClass="app.midore.MainActivity" />
    </shortcut>
</shortcuts>
