<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/midore_widget_bg" android:orientation="vertical" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:textAllCaps="true" android:textColor="@color/midore_vermilion" android:textSize="12sp" android:textStyle="bold" android:letterSpacing="0.06" />
        <ImageView android:id="@+id/add" android:layout_width="28dp" android:layout_height="28dp" android:padding="4dp" android:src="@drawable/midore_ic_add" android:contentDescription="Add a task" />
    </LinearLayout>
    <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp" android:divider="@android:color/transparent" android:dividerHeight="5dp" />
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="top" android:paddingTop="8dp" android:textColor="@color/midore_muted" android:textSize="13sp" />
</LinearLayout>
