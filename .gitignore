# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies (any folder, including native/)
node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

tsconfig.tsbuildinfo

# Owner-only notes (handoff, verification material); never published
/docs/private/
/docs/gtm/

# Handoff for the next agent (owner-only)
/HANDOFF.md

# Impeccable design tooling: scratch output stays local
/.impeccable/mocks/
/.impeccable/review/
/.impeccable/tmp/
/.impeccable/build/
/.impeccable/questions/

# Native apps (also in native/.gitignore): build output, caches, editor and machine files
/native/src-tauri/target/
/native/src-tauri/gen/schemas/
/native/src-tauri/gen/apple/build/
/native/src-tauri/gen/apple/Externals/
/native/src-tauri/gen/android/app/build/
/native/src-tauri/gen/android/build/
/native/src-tauri/gen/android/.gradle/
/native/widgets/apple/build/
/native/widgets/apple/MidoreWidgetsMac.xcodeproj/
/native/plugins/widgets/.tauri/
xcuserdata/
DerivedData/
*.xcuserstate
.idea/
*.iml
.gradle/
local.properties
*.keystore
*.jks
*.p8
*.p12
*.mobileprovision
